# Docker publishes this host port and runs the backend on the same container port.
APP_PORT=4000
APP_EXPOSE_HOST=127.0.0.1
# Optional MongoDB host port; if changed, update MONGODB_URI for host Node too.
MONGODB_EXPOSE_PORT=27019
# Optional: set to the exact browser origin when using localhost instead of 127.0.0.1.
# Default is http://127.0.0.1:<APP_PORT>. No trailing slash.
# APP_URL=http://localhost:4000

# Start in mock mode without provider calls. Use openai for scans/images.
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional account routing (omit rather than leave blank):
# OPENAI_PROJECT_ID=proj_...
# OPENAI_ORG_ID=org_...
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
AI_MAX_CALLS_PER_TASK=5

# Host Node.js settings. Compose overrides these two with its internal paths/URI.
STORAGE_ROOT=./runtime
MONGODB_URI=mongodb://127.0.0.1:27019/medical_extractor?replicaSet=rs0&directConnection=true
MAX_PAGES=20
MAX_UPLOAD_MB=20
REVIEWER_NAME=local-reviewer
HEALTHCHECK_TIMEOUT_MS=3000
HEALTHCHECK_CACHE_TTL_MS=5000
